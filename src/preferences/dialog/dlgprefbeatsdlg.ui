<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>DlgBeatsDlg</class>
 <widget class="QWidget" name="DlgBeatsDlg">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>576</width>
    <height>400</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Beat Detection Preferences</string>
  </property>
  <layout class="QGridLayout" name="gridLayout">
   <item row="0" column="0">
    <widget class="QCheckBox" name="checkBoxAnalyzerEnabled">
     <property name="toolTip">
      <string>When beat detection is enabled, Mixxx detects the beats per minute and beats of your tracks,
automatically shows a beat-grid for them, and allows you to synchronize tracks using their beat information.</string>
     </property>
     <property name="text">
      <string>Enable BPM and Beat Detection</string>
     </property>
    </widget>
   </item>
   <item row="5" column="0">
    <spacer name="verticalSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>20</width>
       <height>40</height>
      </size>
     </property>
    </spacer>
   </item>
   <item row="4" column="0">
    <widget class="QGroupBox" name="groupBoxBeatThis">
     <property name="title"><string>Local Beat This! installation</string></property>
     <layout class="QFormLayout" name="beatThisForm">
      <item row="0" column="0" colspan="2">
       <widget class="QLabel" name="labelBeatThisInfo">
        <property name="text"><string>Choose a Python environment with Beat This! and a downloaded model. Analysis stays on this computer.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
      <item row="1" column="0"><widget class="QLabel" name="labelBeatThisPython"><property name="text"><string>Python interpreter</string></property><property name="buddy"><cstring>lineEditBeatThisPython</cstring></property></widget></item>
      <item row="1" column="1"><layout class="QHBoxLayout" name="beatThisPythonLayout">
       <item><widget class="QLineEdit" name="lineEditBeatThisPython"/></item>
       <item><widget class="QPushButton" name="buttonBeatThisPython"><property name="text"><string>Browse…</string></property></widget></item>
      </layout></item>
      <item row="2" column="0"><widget class="QLabel" name="labelBeatThisModel"><property name="text"><string>Model checkpoint</string></property><property name="buddy"><cstring>lineEditBeatThisModel</cstring></property></widget></item>
      <item row="2" column="1"><layout class="QHBoxLayout" name="beatThisModelLayout">
       <item><widget class="QLineEdit" name="lineEditBeatThisModel"/></item>
       <item><widget class="QPushButton" name="buttonBeatThisModel"><property name="text"><string>Browse…</string></property></widget></item>
      </layout></item>
      <item row="3" column="0"><widget class="QLabel" name="labelBeatThisHash"><property name="text"><string>Model SHA-256</string></property><property name="buddy"><cstring>lineEditBeatThisHash</cstring></property></widget></item>
      <item row="3" column="1"><widget class="QLineEdit" name="lineEditBeatThisHash"><property name="toolTip"><string>The expected SHA-256 fingerprint of the model. The default matches the official final0 checkpoint.</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item row="3" column="0">
    <widget class="QGroupBox" name="groupBox_2">
     <property name="title">
      <string>Analyzer Settings</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout">
      <item>
       <layout class="QHBoxLayout" name="tempoModeLayout">
        <item><widget class="QLabel" name="labelTempoMode">
         <property name="text"><string>Beat grid mode</string></property>
         <property name="buddy"><cstring>comboBoxTempoMode</cstring></property>
        </widget></item>
        <item><widget class="QComboBox" name="comboBoxTempoMode">
         <property name="toolTip"><string>Auto uses a constant grid when it fits the detected beats across the track. Constant forces a single tempo. Variable follows the detected beat positions.</string></property>
        </widget></item>
       </layout>
      </item>
      <item>
       <widget class="QCheckBox" name="checkBoxFastAnalysis">
        <property name="toolTip">
         <string>Enable fast beat detection.
If activated Mixxx only analyzes the first minute of a track for beat information.
This can speed up beat detection on slower computers but may result in lower quality beatgrids.</string>
        </property>
        <property name="text">
         <string>Enable Fast Analysis (For slow computers, may be less accurate)</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="checkBoxReanalyze">
        <property name="toolTip">
         <string>e.g. from 3rd-party programs or Mixxx versions before 1.11.
(Not checked: Analyze only, if no beats exist.)</string>
        </property>
        <property name="text">
         <string>Re-analyze beats when settings change or beat detection data is outdated</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="checkBoxReanalyzeImported">
        <property name="text">
         <string>Re-analyze beatgrids imported from other DJ software</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="horizontalLayout_2">
        <item>
         <widget class="QLabel" name="labelStemStrategy">
          <property name="text">
           <string>Use rhythmic channel when analysing stem file</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="comboBoxStemStrategy">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Maximum" vsizetype="Fixed">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <item>
           <property name="text">
            <string>Disabled</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Enforced</string>
           </property>
          </item>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item row="2" column="0">
    <widget class="QGroupBox" name="groupBox">
     <property name="title">
      <string>Choose Analyzer</string>
     </property>
     <property name="alignment">
      <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
     </property>
     <layout class="QHBoxLayout" name="horizontalLayout">
      <item>
       <widget class="QComboBox" name="comboBoxBeatPlugin">
        <property name="minimumSize">
         <size>
          <width>200</width>
          <height>0</height>
         </size>
        </property>
        <property name="maximumSize">
         <size>
          <width>2600</width>
          <height>26</height>
         </size>
        </property>
        <property name="toolTip">
         <string>Choose between different algorithms to detect beats.</string>
        </property>
        <property name="layoutDirection">
         <enum>Qt::LeftToRight</enum>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
